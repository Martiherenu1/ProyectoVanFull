# Copiá este archivo a .env y completá los valores. NUNCA commitees el .env real.

# --- App ---
ENV=development
API_PREFIX=/api
# Orígenes de Flutter Web separados por comas. Vacío en desarrollo: localhost en cualquier puerto.
# Fuera de desarrollo es obligatoria (en la demo, https://martiherenu1.github.io).
CORS_ORIGINS=

# --- Base de datos (PostgreSQL async) ---
# En docker-compose el host es "db"; en local suele ser "localhost".
# La cadena de Neon (postgresql://…?sslmode=require&channel_binding=require) se acepta tal cual.
DATABASE_URL=postgresql+asyncpg://vanfull:vanfull@db:5432/vanfull

# --- Agente AG-01 (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3.5-lightning:free

# --- Integraciones (entorno de pruebas) ---
MERCADOPAGO_ACCESS_TOKEN=
# CU-036 candidato D3/D6: solo local + DB vf_sandbox_/vf_test_, pendiente aprobación triple.
# No inferir entorno por prefijo del token; secret del webhook externo al repositorio.
MERCADOPAGO_SANDBOX_ENABLED=false
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_CURRENCY=
GOOGLE_MAPS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Auth (RF-045) ---
# Fuera de desarrollo hace falta uno propio de al menos 32 bytes. Para generarlo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
